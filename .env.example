# Copy to .env and fill values locally. NEVER commit .env.

# Value for OPENAI_API_KEY comes from the team group chat (the $50 grant key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# 1 (default) runs the deterministic parser and makes no model calls. 0 uses OPENAI_API_KEY.
DEMO_MODE=0

# --- demo credentials (local only) ------------------------------------------
# The demo merchant's API key. Leave unset and `make reset` generates one, storing it in
# var/merchant-key.txt (gitignored) to paste into the admin page.
DEMO_MERCHANT_KEY=
# Password for the seeded demo shopper (demo@mysa.test). Defaults to mysa-demo-password.
DEMO_CONSUMER_PASSWORD=

# --- payment adapter --------------------------------------------------------
# Keep simulator for the reliable demo path. Set visa only after every Visa sandbox credential
# below is present and the project-specific request schema has passed a live sandbox check.
PAYMENT_ADAPTER=simulator
VISA_API_BASE_URL=https://sandbox.api.visa.com
VISA_ENDPOINT_PATH=/acs/v3/payments/authorizations
VISA_SSL_CERT_PATH=
VISA_SSL_PRIVATE_KEY_PATH=
VISA_CA_BUNDLE_PATH=
VISA_API_USERNAME=
VISA_API_PASSWORD=
VISA_MLE_KEY_ID=
VISA_MLE_PRIVATE_KEY_PATH=
# Visa Server Encryption Certificate downloaded for the same MLE Key-ID above.
VISA_MLE_ENCRYPT_CERT_PATH=
VISA_CLIENT_ID=

# --- receipt email ----------------------------------------------------------
# Leave SMTP_HOST empty for the demo: the receipt is rendered to var/outbox/<order_id>.html
# and the shopper is told it was prepared, not sent. Fill these in to send for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1
RECEIPT_FROM_EMAIL=receipts@sway.demo
RECEIPT_FROM_NAME=Sway Receipts
