# Copy to .env and fill values locally. NEVER commit .env.

# Value for OPENAI_API_KEY comes from the team group chat (the $50 grant key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# 1 (default) runs the deterministic parser and makes no model calls. 0 uses OPENAI_API_KEY.
DEMO_MODE=0

# --- demo credentials (local only) ------------------------------------------
# The demo merchant's API key. Leave unset and `make reset` generates one, storing it in
# var/merchant-key.txt (gitignored) to paste into the admin page.
DEMO_MERCHANT_KEY=
# Password for the seeded demo shopper (demo@mysa.test). Defaults to mysa-demo-password.
DEMO_CONSUMER_PASSWORD=
